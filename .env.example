# ============================================================
# RelayPay Support Agent — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ------------------------------------------------------------
# REQUIRED (server runtime)
# ------------------------------------------------------------

# Data provider for lookups and record persistence.
#   supabase = real Supabase (set the three SUPABASE_* vars below)
#   mock     = deterministic local file store seeded from assets/seed-data
#              (used for automated tests / evaluation without credentials)
DATA_PROVIDER=supabase

# Path used by the mock file store (server, MCP server and evaluation
# must point at the SAME file so records are shared across processes).
# Required only when DATA_PROVIDER=mock.
MOCK_STORE_PATH=./data/mock-store.json

# ------------------------------------------------------------
# SUPABASE (required when DATA_PROVIDER=supabase) — production-grade secrets
# ------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key (server-side ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# ANTHROPIC (required for the Claude Agent SDK brain)
# ------------------------------------------------------------
# If unset, the server runs the rule-based responder instead of Claude
# (same decision engine + real MCP tools, template phrasing — for local
# testing without credentials).
ANTHROPIC_API_KEY=
# Optional: override the model used by the agent (default: claude-sonnet-4-5)
CLAUDE_MODEL=

# ------------------------------------------------------------
# VAPI (voice layer)
# ------------------------------------------------------------
# Public (client-side) key — safe for the browser, used by the web app.
VITE_VAPI_PUBLIC_KEY=
# Assistant ID created in the Vapi dashboard (points at our backend).
VITE_VAPI_ASSISTANT_ID=
# Server secret shared between Vapi and our backend (set in the Vapi
# dashboard server URL secret field AND here; used to verify webhooks).
VAPI_SERVER_SECRET=
# Public HTTPS URL of this backend, configured as the assistant's
# server URL in Vapi (production only).
VAPI_SERVER_URL=

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
PORT=8787
# Allowed browser origins for CORS, comma-separated. Use an explicit
# list in production, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# LOCAL-ONLY (tests / evaluation)
# ------------------------------------------------------------
# Base URL used by evaluation scripts when calling a running server.
# The evaluation harness runs the orchestrator in-process by default.
SERVER_URL=http://localhost:8787
