# ============================================================
# RelayPay Support Agent — environment variables
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# ------------------------------------------------------------
# REQUIRED (server runtime)
# ------------------------------------------------------------

# Data provider for lookups and record persistence.
#   supabase = real Supabase (set the three SUPABASE_* vars below)
#   mock     = deterministic local file store seeded from assets/seed-data
#              (used for automated tests / evaluation without credentials)
DATA_PROVIDER=supabase

# Path used by the mock file store (server, MCP server and evaluation
# must point at the SAME file so records are shared across processes).
# Required only when DATA_PROVIDER=mock.
MOCK_STORE_PATH=./data/mock-store.json

# ------------------------------------------------------------
# SUPABASE (required when DATA_PROVIDER=supabase) — production-grade secrets
# ------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# Service role key (server-side ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------
# ANTHROPIC (required in production: the Claude Agent SDK backend agent)
# ------------------------------------------------------------
# If unset, the server runs the deterministic responder instead of Claude
# (same decision engine + real MCP tools, template wording — for local
# testing without credentials). /api/health reports which one is active.
ANTHROPIC_API_KEY=
# Optional: backend model (default: claude-sonnet-4-5)
CLAUDE_MODEL=
# Optional: per-turn model timeout in ms before falling back to the
# deterministic wording (default 12000 — keep well under Vapi's tool timeout)
CLAUDE_TIMEOUT_MS=
# Optional: tighter model budget for voice turns, which must fit Vapi's
# tool timeout (default 8000)
CLAUDE_VOICE_TIMEOUT_MS=
# Optional: after two consecutive model failures, skip Claude for this
# long so callers don't wait on a failing model (default 300000 = 5 min)
CLAUDE_COOLDOWN_MS=
# Optional: set to false to skip mounting the read-only MCP lookups for
# Claude (saves one subprocess per reply on 512 MB hosts)
CLAUDE_MOUNT_MCP=

# ------------------------------------------------------------
# VAPI (voice layer)
# ------------------------------------------------------------
# Public (client-side) key — safe for the browser, used by the web app.
VITE_VAPI_PUBLIC_KEY=
# Assistant ID created in the Vapi dashboard (points at our backend).
VITE_VAPI_ASSISTANT_ID=
# Server secret shared between Vapi and our backend (set in the Vapi
# dashboard server URL secret field AND here; used to verify webhooks).
VAPI_SERVER_SECRET=
# Public HTTPS URL of this backend, configured as the assistant's
# server URL in Vapi (production only).
VAPI_SERVER_URL=

# ------------------------------------------------------------
# SERVER
# ------------------------------------------------------------
# When set, /api/debug/* requires a matching `x-debug-token` header.
# Set this in production: debug endpoints expose transcripts and
# escalation contact details. On Render (RENDER=true) or with
# NODE_ENV=production they are disabled entirely when this is unset.
DEBUG_TOKEN=
# HMAC secret for text-conversation tokens (x-conversation-token). Set a
# long random value in production so tokens survive restarts; falls back
# to DEBUG_TOKEN / VAPI_SERVER_SECRET, else a per-process random secret.
CONVERSATION_TOKEN_SECRET=
# Text-channel requests per minute per client IP (0 disables; default 30)
RATE_LIMIT_PER_MINUTE=30
# Idle MCP subprocesses (one per conversation, ~80 MB each) are closed
# after this many ms (default 600000 = 10 minutes)
MCP_IDLE_MS=600000
PORT=8787
# Allowed browser origins for CORS, comma-separated. Use an explicit
# list in production, e.g. https://your-app.vercel.app
CORS_ORIGINS=http://localhost:5173

# ------------------------------------------------------------
# LOCAL-ONLY (tests / evaluation)
# ------------------------------------------------------------
# `npm run evaluate` always uses an isolated mock store, whatever
# DATA_PROVIDER says. Persist to Supabase explicitly with
# `npm run evaluate:supabase`. EVAL_RESPONDER=claude keeps Claude phrasing.
EVAL_RESPONDER=
