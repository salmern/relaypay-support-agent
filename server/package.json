{
  "name": "@relaypay/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./app": "./dist/app.js",
    "./orchestrator": "./dist/orchestrator.js"
  },
  "scripts": {
